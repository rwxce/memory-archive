{
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "pnpm check *": "allow",
      "pnpm test *": "allow",
      "pnpm lint *": "allow",
      "pnpm typecheck *": "allow",
      "pnpm exec tsc *": "allow",
      "pnpm rulesync:check *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr status*": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh repo view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh api * --method GET *": "allow",
      "gh issue comment *": "deny",
      "gh pr comment *": "deny",
      "gh pr review *": "deny",
      "gh api * -f *": "deny",
      "gh api * -F *": "deny",
      "gh api * --raw-field *": "deny",
      "gh api * --field *": "deny",
      "gh api * --input *": "deny",
      "gh api * --method POST *": "deny",
      "gh api * --method PUT *": "deny",
      "gh api * --method PATCH *": "deny",
      "gh api * --method DELETE *": "deny",
      "gh api * -X POST *": "deny",
      "gh api * -X PUT *": "deny",
      "gh api * -X PATCH *": "deny",
      "gh api * -X DELETE *": "deny",
      ". .env*": "deny",
      "awk*.env*": "deny",
      "cat ./.env*": "deny",
      "cat .env*": "deny",
      "grep*.env*": "deny",
      "head*.env*": "deny",
      "less .env*": "deny",
      "more .env*": "deny",
      "nl .env*": "deny",
      "od*.env*": "deny",
      "sed*.env*": "deny",
      "source .env*": "deny",
      "strings .env*": "deny",
      "tail*.env*": "deny",
      "xxd .env*": "deny",
      "gh -R * pr comment *": "deny",
      "gh -R * pr review *": "deny",
      "gh -R * issue comment *": "deny",
      "gh --repo * pr comment *": "deny",
      "gh --repo * pr review *": "deny",
      "gh --repo * issue comment *": "deny",
      "cat fixtures/*": "deny",
      "cat data/*": "deny",
      "cat output/*": "deny",
      "cat backup/*": "deny",
      "cat *_chat.txt*": "deny",
      "cat *WhatsApp Chat*": "deny",
      "head *_chat.txt*": "deny",
      "tail *_chat.txt*": "deny",
      "grep*fixtures/*": "deny"
    },
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "node_modules/": "deny",
      "dist/": "deny",
      "out/": "deny",
      "coverage/": "deny",
      "data/": "deny",
      "output/": "deny",
      "backup/": "deny",
      "*.zip": "deny",
      "_chat.txt": "deny",
      "**/_chat.txt": "deny",
      "fixtures/": "deny",
      "WhatsApp Chat*.txt": "deny",
      "**/WhatsApp Chat*.txt": "deny"
    }
  }
}
