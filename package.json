{
  "name": "wa-backup",
  "version": "0.1.1",
  "description": "WhatsApp chat export backup tool — streaming parser producing a CSV source-of-truth",
  "type": "module",
  "bin": {
    "wa-backup": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "backup",
    "export",
    "markdown",
    "html",
    "csv"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guionardo/wa-backup.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "node scripts/generate-fixtures.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "rulesync": "rulesync generate",
    "rulesync:check": "rulesync generate --check"
  },
  "dependencies": {
    "commander": "15.0.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "rulesync": "33.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@11.28.5"
}
