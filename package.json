{
  "name": "memory-archive",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, fully offline memory archive for WhatsApp conversations, photos, videos and voice messages",
  "type": "module",
  "bin": {
    "memory-archive": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "keywords": [
    "whatsapp",
    "memories",
    "archive",
    "backup",
    "offline",
    "pwa",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwxce/memory-archive.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx cli/index.ts",
    "start": "tsx cli/index.ts",
    "build": "node scripts/build-viewer-script.mjs && tsup",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/generate-fixtures.mjs && vitest run",
    "test:watch": "node scripts/generate-fixtures.mjs && vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "rulesync": "rulesync generate",
    "rulesync:check": "rulesync generate --check"
  },
  "dependencies": {
    "commander": "15.0.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "rulesync": "33.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.28.5"
}
