{
  "name": "memory-archive",
  "private": true,
  "version": "0.9.0",
  "description": "Privacy-first, fully offline memory archive for WhatsApp conversations, photos, videos and voice messages",
  "type": "module",
  "bin": {
    "memory-archive": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "keywords": [
    "whatsapp",
    "memories",
    "archive",
    "backup",
    "offline",
    "pwa",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwxce/memory-archive.git"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "node scripts/build-db-worker.mjs && NEXT_TELEMETRY_DISABLED=1 next dev",
    "cli": "tsx cli/index.ts",
    "build": "node scripts/build-viewer-script.mjs && tsup && node scripts/build-db-worker.mjs && NEXT_TELEMETRY_DISABLED=1 next build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve-out.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/generate-fixtures.mjs && vitest run",
    "test:watch": "node scripts/generate-fixtures.mjs && vitest",
    "check": "pnpm i18n:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "rulesync": "rulesync generate",
    "rulesync:check": "rulesync generate --check",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commander": "15.0.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "picocolors": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "9.5.13",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@serwist/build": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "rulesync": "33.0.0",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.28.5"
}
